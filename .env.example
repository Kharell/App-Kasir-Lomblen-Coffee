# ---- Server ----
# Biarkan kosong untuk berjalan dalam mode DEMO (data in-memory, tanpa MongoDB).
# Isi untuk memakai MongoDB sungguhan.
MONGODB_URI=mongodb://127.0.0.1:27017/lomblen-cofe

# ---- Auth (WAJIB diganti di produksi, min. 32 karakter) ----
JWT_SECRET=ganti-dengan-random-secret-minimal-32-karakter
JWT_EXPIRES_IN=8h

# ---- Payment Gateway (opsional, isi bila integrasi Midtrans aktif) ----
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_PRODUCTION=false